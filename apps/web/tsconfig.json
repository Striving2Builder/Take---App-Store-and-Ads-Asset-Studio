{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@take/core": ["../../packages/core/src/index.ts"],
      "@take/modes-sdk": ["../../packages/modes-sdk/src/index.ts"],
      "@take/device-catalog": ["../../packages/device-catalog/src/index.ts"],
      "@take/scan-client": ["../../packages/scan-client/src/index.ts"],
      "@take/storage": ["../../packages/storage/src/index.ts"],
      "@take/template-engine": ["../../packages/template-engine/src/index.ts"],
      "@take/export-presets": ["../../packages/export-presets/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
